# Copy to .env.local and fill what you use. Empty = adapter is skipped.

# --- Brand generator (npm run brand -- <slug>) ---
# Required: Claude generates name / tagline / font / palette / hero prompt.
ANTHROPIC_API_KEY=
# Image gen — set ONE. OpenAI gpt-image-1 (needs org verification) OR
# Replicate Flux 1.1 Pro (just an API token). Whichever is set is used.
OPENAI_API_KEY=
REPLICATE_API_TOKEN=


# --- Meta (Instagram + Facebook ads) ---
# Pixel ID — found in Events Manager. Used by browser pixel.
NEXT_PUBLIC_META_PIXEL_ID=
# Conversions API access token — Events Manager → Settings → Generate Token.
META_CAPI_TOKEN=
# Same as pixel id; used server-side for CAPI.
META_CAPI_PIXEL_ID=
# "test" event code while validating in Events Manager. Leave empty in prod.
META_CAPI_TEST_CODE=

# --- GA4 (Measurement Protocol, server-side) ---
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
GA4_API_SECRET=

# --- PostHog (funnels, heatmaps, session replay — generous free tier) ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Plausible (lightweight, privacy-friendly; optional) ---
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# --- Lead capture forwarding ---
# Generic webhook (Zapier / Make / Google Apps Script / Slack incoming webhook).
LEAD_WEBHOOK_URL=
# Resend API key — emails you each new lead.
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=
LEAD_FROM_EMAIL=onboarding@resend.dev
