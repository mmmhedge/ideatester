# Copy to .env.local and fill what you use. Empty = adapter is skipped.

# --- X / Twitter API (npm run x -- ...) ---
# Get these at https://developer.x.com/en/portal/dashboard
# Create an app with OAuth 2.0 (User context, type "Confidential client"),
# add callback URL http://127.0.0.1:8787/callback, and enable read+write.
X_CLIENT_ID=
X_CLIENT_SECRET=

# --- Brand + litepaper + promo generators ---
# Required for all: Claude generates names, taglines, litepapers, post drafts,
# promo plans. Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Image gen for brand (set ONE):
# OpenAI gpt-image-1 (needs org verification) OR
# Replicate (also used by `npm run promo` for AI video). Recommended.
OPENAI_API_KEY=
REPLICATE_API_TOKEN=

# Optional: public URL to your deployed site. Lets the consumer promo preset
# image-prime the AI video model with your generated hero image, giving
# better visual continuity with the landing page.
PUBLIC_BASE_URL=

# Optional: explicit music file path for promo videos. Otherwise the script
# looks for public/promo/music/<preset>.mp3 (crypto.mp3 or consumer.mp3).
PROMO_MUSIC=


# --- Meta (Instagram + Facebook ads) ---
# Pixel ID — found in Events Manager. Used by browser pixel.
NEXT_PUBLIC_META_PIXEL_ID=
# Conversions API access token — Events Manager → Settings → Generate Token.
META_CAPI_TOKEN=
# Same as pixel id; used server-side for CAPI.
META_CAPI_PIXEL_ID=
# "test" event code while validating in Events Manager. Leave empty in prod.
META_CAPI_TEST_CODE=

# --- GA4 (Measurement Protocol, server-side) ---
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
GA4_API_SECRET=

# --- PostHog (funnels, heatmaps, session replay — generous free tier) ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Plausible (lightweight, privacy-friendly; optional) ---
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# --- Lead capture forwarding ---
# Generic webhook (Zapier / Make / Google Apps Script / Slack incoming webhook).
LEAD_WEBHOOK_URL=
# Resend API key — emails you each new lead.
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=
LEAD_FROM_EMAIL=onboarding@resend.dev
